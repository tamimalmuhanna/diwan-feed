    {"id": "2124587926914736590", "handle": "SPAregions", "text": "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629: \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062a\u0624\u0643\u062f \u0631\u0641\u0636\u0647\u0627 \u0627\u0644\u0642\u0627\u0637\u0639 \u0644\u0647\u0630\u0647 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621\u0627\u062a \u0627\u0644\u063a\u0627\u0634\u0645\u0629\u060c \u0648\u062a\u0634\u062f\u062f \u0639\u0644\u0649 \u0636\u0631\u0648\u0631\u0629 \u0627\u062d\u062a\u0631\u0627\u0645 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u062f\u0648\u0644\u064a \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064a\u060c \u0648\u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u062f\u0646\u064a\u064a\u0646 \u0648\u0627\u0644\u0645\u0646\u0634\u0622\u062a \u0627\u0644\u0645\u062f\u0646\u064a\u0629 \u0648\u0645\u0642\u0627\u0631 \u0627\u0644\u0645\u0646\u0638\u0645\u0627\u062a \u0627\u0644\u062f\u0648\u0644\u064a\u0629\u060c \u0648\u0636\u0645\u0627\u0646 \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0639\u0627\u0645\u0644\u064a\u0646 \u0641\u064a\u0647\u0627\u060c \u0648\u062a\u062c\u0646\u064a\u0628 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0633\u0648\u062f\u0627\u0646\u064a \u0627\u0644\u0634\u0642\u064a\u0642 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0646\u0627\u0629\u060c \u0648\u062a\u062c\u062f\u062f \u0645\u0648\u0642\u0641\u0647\u0627 \u0627\u0644\u062b\u0627\u0628\u062a \u0627\u0644\u062f\u0627\u0639\u064a \u0625\u0644\u0649 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0623\u0645\u0646 \u0627\u0644\u0633\u0648\u062f\u0627\u0646 \u0648\u0627\u0633\u062a\u0642\u0631\u0627\u0631\u0647 \u0648\u0648\u062d\u062f\u062a\u0647 \u0648\u0633\u064a\u0627\u062f\u062a\u0647 \u0648\u0645\u0624\u0633\u0633\u0627\u062a\u0647 \u0627\u0644\u0634\u0631\u0639\u064a\u0629.\n#\u0648\u0627\u0633", "timestamp": "2026-11-22T19:36:49Z"