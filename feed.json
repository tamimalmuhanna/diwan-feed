      "text": "\u0625\u0646\u0641\u0627\u0630\u064b\u0627 \u0644\u0623\u0645\u0631 #\u062e\u0627\u062f\u0645_\u0627\u0644\u062d\u0631\u0645\u064a\u0646_\u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646..\n\u0645\u0639\u0627\u0644\u064a \u0631\u0626\u064a\u0633 \u0647\u064a\u0626\u0629 \u0627\u0644\u0623\u0631\u0643\u0627\u0646 \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0623\u0648\u0644 \u0627\u0644\u0631\u0643\u0646 \u0641\u064a\u0627\u0636 \u0627\u0644\u0631\u0648\u064a\u0644\u064a\u060c \u064a\u064f\u0642\u0644\u064e\u0651\u062f \u0645\u0639\u0627\u0644\u064a \u0631\u0626\u064a\u0633 \u0623\u0631\u0643\u0627\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u064a\u0648\u0646\u0627\u0646\u064a \u0627\u0644\u0641\u0631\u064a\u0642 \u0623\u0648\u0644 \u062f\u064a\u0645\u064a\u062a\u0631\u064a\u0648\u0633 \u0647\u0648\u0628\u064a\u0633\u060c \u0648\u0633\u0627\u0645 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0645\u0646 \u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u0629\u060c \u062a\u0642\u062f\u064a\u0631\u064b\u0627 \u0644\u062c\u0647\u0648\u062f\u0647 \u0627\u0644\u0645\u0645\u064a\u0632\u0629 \u0641\u064a \u062a\u0648\u0637\u064a\u062f \u0623\u0648\u0627\u0635\u0631 \u0627\u0644\u0635\u062f\u0627\u0642\u0629 \u0648\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u060c \u0648\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u064a\u0648\u0646\u0627\u0646\u064a\u0629.",
