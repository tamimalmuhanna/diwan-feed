      "handle": "modgovksa",
      "text": "\u0627\u0644\u062a\u0642\u0649 \u0635\u0627\u062d\u0628 \u0627\u0644\u0633\u0645\u0648 \u0627\u0644\u0645\u0644\u0643\u064a \u0627\u0644\u0623\u0645\u064a\u0631 \u062e\u0627\u0644\u062f \u0628\u0646 \u0633\u0644\u0645\u0627\u0646 \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0648\u0632\u064a\u0631 \u0627\u0644\u062f\u0641\u0627\u0639\u060c \u0641\u064a \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\u0629 \u0623\u0628\u0648\u0638\u0628\u064a\u060c \u0627\u0644\u064a\u0648\u0645\u060c \u0633\u0645\u0648 \u0627\u0644\u0634\u064a\u062e \u0645\u0646\u0635\u0648\u0631 \u0628\u0646 \u0632\u0627\u064a\u062f \u0622\u0644 \u0646\u0647\u064a\u0627\u0646 \u0646\u0627\u0626\u0628 \u0631\u0626\u064a\u0633 \u062f\u0648\u0644\u0629 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0627\u0644\u0634\u0642\u064a\u0642\u0629 \u0646\u0627\u0626\u0628 \u0631\u0626\u064a\u0633 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0631\u0626\u064a\u0633 \u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0631\u0626\u0627\u0633\u0629.\n\n\u0648\u062c\u0631\u0649 \u062e\u0644\u0627\u0644 \u0627\u0644\u0644\u0642\u0627\u0621 \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u0623\u0647\u0645\u064a\u0629 \u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0648\u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u061b \u0628\u0645\u0627 \u064a\u0633\u0647\u0645 \u0641\u064a \u062f\u0639\u0645 \u0623\u0645\u0646 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0648\u0627\u0633\u062a\u0642\u0631\u0627\u0631\u0647\u0627.",
