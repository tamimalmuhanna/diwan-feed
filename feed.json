      "text": "\u0633\u0645\u0648 #\u0648\u0644\u064a_\u0627\u0644\u0639\u0647\u062f: \u0646\u0624\u0643\u062f \u0623\u0646 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0645\u0627\u0636\u064a\u0629\u060c \u0628\u0642\u064a\u0627\u062f\u0629 \u0648\u062a\u0648\u062c\u064a\u0647\u0627\u062a #\u062e\u0627\u062f\u0645_\u0627\u0644\u062d\u0631\u0645\u064a\u0646_\u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646 \u0641\u064a \u0627\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0648\u0633\u064a\u0639 \u0641\u0631\u0635 \u0623\u0628\u0646\u0627\u0626\u0646\u0627 \u0648\u0628\u0646\u0627\u062a\u0646\u0627\u060c \u0648\u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0627\u0644\u0648\u0637\u0646 \u0648\u0623\u0645\u0646\u0647 \u0648\u0633\u064a\u0627\u062f\u062a\u0647 \u0627\u0644\u062a\u064a \u0644\u0627 \u0646\u0642\u0628\u0644 \u0627\u0644\u0645\u0633\u0627\u0633 \u0628\u0647\u0627\u060c \u0648\u0627\u0644\u062f\u0641\u0627\u0639 \u0639\u0646 \u0645\u0642\u062f\u0631\u0627\u062a\u0647 \u0628\u0643\u0644 \u0642\u0648\u0629 \u0648\u062d\u0632\u0645\u060c \u0648\u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u0646\u0645\u0648 \u0648\u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u0623\u0635\u0639\u062f\u0629\u060c \u0645\u0631\u0633\u062e\u0651\u064a\u0646 \u062f\u0648\u0631 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0641\u0627\u0639\u0644 \u0641\u064a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u060c \u0648\u0641\u064a \u0625\u0631\u0633\u0627\u0621 \u062f\u0639\u0627\u0626\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0641\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u0645 \u0628\u062d\u0643\u0645\u0629 \u0648\u0645\u0648\u0636\u0648\u0639\u064a\u0629.\n#\u0645\u064