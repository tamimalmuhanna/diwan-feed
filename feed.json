    {"id": "2124714556903825418", "handle": "SPAregions", "text": "#\u0627\u0644\u0623\u0631\u0635\u0627\u062f: \u062a\u0648\u0642\u0639\u0627\u062a \u0633\u0645\u0627\u0621 \u063a\u0627\u0626\u0645\u0629 \u062c\u0632\u0626\u064a\u064b\u0627 \u0645\u0639 \u0641\u0631\u0635\u0629 \u062a\u0643\u0648\u0646 \u0633\u062d\u0628 \u0631\u0639\u062f\u064a\u0629 \u0645\u0645\u0637\u0631\u0629 \u0645\u0635\u062d\u0648\u0628\u0629 \u0628\u0631\u064a\u0627\u062d \u0646\u0634\u0637\u0629 \u0639\u0644\u0649 \u062c\u0627\u0632\u0627\u0646\u060c \u0639\u0633\u064a\u0631\u060c \u0627\u0644\u0628\u0627\u062d\u0629\u060c \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0645\u0639 \u062a\u0643\u0648\u0646 \u0627\u0644\u0636\u0628\u0627\u0628\u060c \u0643\u0630\u0644\u0643 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0642\u064a\u0629.\n#\u0648\u0627\u0633", "timestamp": "2026-11-23T04:00:00Z", "likes": 20, "reposts": 10},
