    {"id": "2124587672702538117", "handle": "SPAregions", "text": "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u062a\u064f\u0639\u0631\u0628 \u0639\u0646 \u0625\u062f\u0627\u0646\u0629 \u0648\u0627\u0633\u062a\u0646\u0643\u0627\u0631 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0628\u0634\u062f\u0629 \u0644\u0644\u0647\u062c\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0647\u062f\u0641\u062a \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0633\u0648\u062f\u0627\u0646\u064a\u0629 \u0627\u0644\u062e\u0631\u0637\u0648\u0645 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0637\u0627\u0626\u0631\u0627\u062a \u0627\u0644\u0645\u0633\u064a\u0651\u0631\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0623\u062d\u062f \u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0644\u0623\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0648\u0645\u0627 \u0623\u0633\u0641\u0631\u062a \u0639\u0646\u0647 \u0645\u0646 \u0633\u0642\u0648\u0637 \u0636\u062d\u0627\u064a\u0627 \u0645\u062f\u0646\u064a\u064a\u0646 \u0648\u0623\u0636\u0631\u0627\u0631 \u0637\u0627\u0644\u062a \u0627\u0644\u0623\u0639\u064a\u0627\u0646 \u0648\u0627\u0644\u0645\u0646\u0634\u0622\u062a \u0627\u0644\u0645\u062f\u0646\u064a\u0629.\nhttps://www.spa.gov.sa/N2733912 \n#\u0648\u0627\u0633", "timestamp": "2026-11-22T19:35:48Z", "likes": 252, "reposts": 121},
